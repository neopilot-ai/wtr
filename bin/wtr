#!/usr/bin/env bash
# wtr - Convenience wrapper for git-wtr
# The main binary is bin/git-wtr; this wrapper allows ./bin/wtr for development.

# Find this script's real location (resolve symlinks)
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ $SRC != /* ]] && SRC="$DIR/$SRC"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SRC")" && pwd)"

# Execute the main git-wtr script
exec "$SCRIPT_DIR/git-wtr" "$@"

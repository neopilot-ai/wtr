#!/usr/bin/env bash
# git-wtr - Git worktree runner
# Portable, cross-platform git worktree management
# Invoked as: git wtr <command> (git subcommand via PATH discovery)

# -E propagates the ERR trap below into functions, command substitutions and
# subshells. Without it the WTR_DEBUG trap never fires, because every command
# runs inside main() and a cmd_* handler. With no ERR trap installed, -E has no
# effect, so the default path behaves exactly as it did with plain -e.
set -eE

# Debug: show file:line:function on set -e failures
if [ -n "${WTR_DEBUG:-}" ]; then
  trap 'printf "ERROR at %s:%s in %s()\n" "${BASH_SOURCE[0]}" "$LINENO" "${FUNCNAME[0]:-main}" >&2' ERR
fi

# Version
WTR_VERSION="2.11.1"

# Find the script directory (resolve symlinks; allow env override)
resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/.." && pwd
}
: "${WTR_DIR:=$(resolve_script_dir)}"

# Source library files
. "$WTR_DIR/lib/ui.sh"
. "$WTR_DIR/lib/args.sh"
. "$WTR_DIR/lib/config.sh"
_ui_apply_color_config
. "$WTR_DIR/lib/platform.sh"
. "$WTR_DIR/lib/core.sh"
. "$WTR_DIR/lib/copy.sh"
. "$WTR_DIR/lib/hooks.sh"
. "$WTR_DIR/lib/provider.sh"
. "$WTR_DIR/lib/adapters.sh"
. "$WTR_DIR/lib/launch.sh"

# Source command handlers
for _cmd_file in "$WTR_DIR"/lib/commands/*.sh; do
  # shellcheck disable=SC1090
  . "$_cmd_file"
done
unset _cmd_file

# Main dispatcher
main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  # Set for per-command help (used by show_command_help in ui.sh)
  _WTR_CURRENT_COMMAND="$cmd"

  case "$cmd" in
    new)
      cmd_create "$@"
      ;;
    pr)
      cmd_pr "$@"
      ;;
    rm)
      cmd_remove "$@"
      ;;
    mv|rename)
      cmd_rename "$@"
      ;;
    go)
      cmd_go "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    editor)
      cmd_editor "$@"
      ;;
    ai)
      cmd_ai "$@"
      ;;
    copy)
      cmd_copy "$@"
      ;;
    ls|list)
      cmd_list "$@"
      ;;
    clean)
      cmd_clean "$@"
      ;;
    doctor)
      cmd_doctor "$@"
      ;;
    adapter|adapters)
      cmd_adapter "$@"
      ;;
    config)
      cmd_config "$@"
      ;;
    completion)
      cmd_completion "$@"
      ;;
    init)
      cmd_init "$@"
      ;;
    trust)
      cmd_trust "$@"
      ;;
    version|--version|-v)
      echo "git wtr version $WTR_VERSION"
      ;;
    help|--help|-h)
      cmd_help "$@"
      ;;
    cd)
      local _shell_name
      _shell_name="$(basename "${SHELL:-bash}")"
      log_error "'cd' requires shell integration (subprocesses cannot change your shell's directory)"
      log_info "Run 'git wtr help init' for setup instructions"
      log_info "Then use: wtr cd [<branch>]"
      exit 1
      ;;
    *)
      log_error "Unknown command: $cmd"
      echo "Use 'git wtr help' for available commands"
      exit 1
      ;;
  esac
}

# Run main
main "$@"
